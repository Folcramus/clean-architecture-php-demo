{
  "name": "demo/clean-architecture-php",
  "description": "Educational Clean Architecture demo in pure PHP",
  "type": "project",
  "require": {
    "php": ">=8.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "serve": "php -S 127.0.0.1:8080 -t public"
  }
}
